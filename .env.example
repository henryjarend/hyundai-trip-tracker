# Bluelink credentials — the same ones you use in the MyHyundai app / BetterBlue.
HYUNDAI_USERNAME=you@example.com
HYUNDAI_PASSWORD=your-bluelink-password
HYUNDAI_PIN=1234

# Postgres. When running under docker compose the host is `db`.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hyundai

# How often the poller runs. Hyundai only ever exposes the last ~4 trips, so this
# must be shorter than the time it takes you to make 4 trips. 15 minutes is safe.
POLL_INTERVAL_MINUTES=15

# `startdate` in the trip payload carries no timezone. This is the timezone the
# car reports in — used to convert those naive timestamps to real instants.
VEHICLE_TZ=America/Chicago

# The `offset` header BetterBlue sends. Should match your UTC offset in hours.
HYUNDAI_UTC_OFFSET=-5

# API server
PORT=3000

# Set to 1 to log outgoing request headers (redacted) — useful when debugging auth.
DEBUG_HTTP=0

# --- Live location (findMyCar) ---
# Fetches a real position fix instead of relying on whatever position the car last
# volunteered with its status. The endpoint is RATE LIMITED, so it is only called when
# the car has actually moved or is running, never on a fixed timer. Set to 0 to
# disable entirely; trips are unaffected either way.
LOCATION_ENABLED=1

# Minimum minutes between fixes while the car is parked. A parked car's position
# cannot have changed, so this is mostly a backstop.
LOCATION_INTERVAL_MINUTES=60

# Minimum minutes between fixes while the engine is running — the only time position
# is actually changing, so the floor is lower.
LOCATION_ACTIVE_INTERVAL_MINUTES=10

# After the backend refuses with HT_534, wait this long before trying again. Doubles
# per consecutive refusal, capped at LOCATION_BACKOFF_MAX_MINUTES.
LOCATION_BACKOFF_MINUTES=60
LOCATION_BACKOFF_MAX_MINUTES=720
